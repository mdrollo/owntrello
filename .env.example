# Kopieren nach .env und anpassen. .env wird nie committet.
# Auf Azure werden dieselben Werte als App-Einstellungen gesetzt.

PORT=8080
# Verzeichnis für SQLite-Datenbank und Anhänge (lokal: ./data, Container: /data, Azure: /home/data)
DATA_DIR=./data
TZ=Europe/Berlin

# /api nur mit Azure-Anmeldung (auf Azure: true, lokal: false).
# ACHTUNG: true nur hinter der App-Service-Anmeldung (Easy Auth) – sie setzt die
# Header X-MS-CLIENT-PRINCIPAL-* und entfernt sie aus fremden Anfragen.
REQUIRE_AUTH=false

# Benutzer für die lokale Entwicklung ohne Anmeldung
DEV_USER_ID=dev
DEV_USER_NAME=Entwickler
DEV_USER_EMAIL=dev@localhost

# Administratoren (Entra-Objekt-IDs oder E-Mail-Adressen, kommagetrennt): sehen und
# verwalten alle Boards. Leer = der erste Benutzer, der sich anmeldet.
ADMIN_USERS=

# Höchstgröße eines Anhangs in MB
MAX_ATTACHMENT_MB=25
