{
  "name": "@owntrello/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@owntrello/shared": "*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.1.0"
  }
}
